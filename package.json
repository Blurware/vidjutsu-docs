{
  "name": "vidjutsu-docs",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "build": "cd apps/web && bun run build",
    "build:spec": "node scripts/build-spec.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "node scripts/build-spec.mjs --check && node scripts/check-docs.mjs"
  },
  "packageManager": "bun@1.3.10",
  "dependencies": {
    "convex": "^1.34.1"
  }
}
