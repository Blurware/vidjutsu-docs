{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "VidJutsu",
  "description": "Video editing built for agents: upload takes, edit a timeline with history, and render it on cloud machines.",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "api": {
    "baseUrl": "https://api.vidjutsu.ai",
    "auth": {
      "method": "bearer"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "mcp"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/uploads",
              "guides/editing",
              "guides/rendering",
              "guides/audio"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "pricing",
              "errors"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "legal/terms"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi/spec.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Sign-up and sign-in",
            "pages": [
              "POST /v3/auth/email",
              "POST /v3/auth/verify"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "GET /v3/account",
              "POST /v3/account",
              "GET /v3/usage",
              "GET /v3/entitlements"
            ]
          },
          {
            "group": "API keys",
            "pages": [
              "GET /v3/keys",
              "POST /v3/keys",
              "DELETE /v3/keys/{key_id}"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "POST /v3/billing/checkout",
              "POST /v3/billing/portal"
            ]
          },
          {
            "group": "Media",
            "pages": [
              "POST /v3/media",
              "GET /v3/media/{hash}",
              "GET /v3/media/{hash}/url"
            ]
          },
          {
            "group": "Uploads",
            "pages": [
              "POST /v3/uploads",
              "POST /v3/uploads/{upload_id}/complete",
              "DELETE /v3/uploads/{upload_id}"
            ]
          },
          {
            "group": "Projects",
            "pages": [
              "POST /v3/projects",
              "GET /v3/projects/{project}",
              "POST /v3/projects/{project}/edits"
            ]
          },
          {
            "group": "Audio",
            "pages": [
              "POST /v3/projects/{project}/level",
              "POST /v3/audio/clean"
            ]
          },
          {
            "group": "Renders",
            "pages": [
              "POST /v3/projects/{project}/renders",
              "GET /v3/jobs/{job_id}",
              "POST /v3/jobs/{job_id}/cancel"
            ]
          },
          {
            "group": "Status",
            "pages": [
              "GET /v3/health"
            ]
          }
        ]
      },
      {
        "tab": "CLI and SDK",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/index"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "sdk/index"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/tfcbot/vidjutsu-sdk",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://docs.vidjutsu.ai/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/tfcbot/vidjutsu-sdk"
    }
  },
