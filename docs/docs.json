{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "VidJutsu",
  "description": "Video editing built for agents: upload takes, edit a timeline with history, and render it on cloud machines.",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "api": {
    "baseUrl": "https://api.vidjutsu.ai",
    "auth": {
      "method": "bearer"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "mcp"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/uploads",
              "guides/editing",
              "guides/look-and-check",
              "guides/rendering",
              "guides/shot-list",
              "guides/import-descript",
              "guides/agents",
              "guides/live-updates",
              "guides/layouts",
              "guides/studio-sound",
              "guides/audio"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "pricing",
              "errors"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "legal/terms"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi/spec.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Sign-up and sign-in",
            "pages": [
              "POST /auth/email",
              "POST /auth/verify"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "GET /account",
              "POST /account",
              "GET /usage",
              "GET /entitlements"
            ]
          },
          {
            "group": "API keys",
            "pages": [
              "GET /keys",
              "POST /keys",
              "DELETE /keys/{key_id}"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "POST /billing/checkout",
              "POST /billing/top-up",
              "POST /billing/auto-top-up",
              "POST /billing/portal",
              "GET /wallet",
              "GET /projects/{project}/quote"
            ]
          },
          {
            "group": "Media",
            "pages": [
              "POST /media",
              "GET /media/{hash}",
              "GET /media/{hash}/url",
              "POST /media/{hash}/preview",
              "GET /media/{hash}/preview",
              "POST /media/{hash}/transcript",
              "GET /media/{hash}/transcript"
            ]
          },
          {
            "group": "Uploads",
            "pages": [
              "POST /uploads",
              "POST /uploads/{upload_id}/complete",
              "DELETE /uploads/{upload_id}"
            ]
          },
          {
            "group": "Projects",
            "pages": [
              "GET /projects",
              "POST /projects",
              "POST /imports",
              "GET /projects/{project}",
              "GET /projects/{project}/head",
              "POST /projects/{project}/edits",
              "GET /projects/{project}/timeline-words"
            ]
          },
          {
            "group": "History",
            "pages": [
              "GET /projects/{project}/history",
              "POST /projects/{project}/undo",
              "POST /projects/{project}/restore"
            ]
          },
          {
            "group": "Shot list",
            "pages": [
              "GET /projects/{project}/shot-list",
              "POST /projects/{project}/shot-list/edits",
              "POST /projects/{project}/shot-list/import",
              "GET /projects/{project}/files",
              "GET /projects/{project}/words"
            ]
          },
          {
            "group": "Layouts",
            "pages": [
              "GET /layouts",
              "POST /layouts",
              "DELETE /layouts/{layout_id}",
              "POST /projects/{project}/layout"
            ]
          },
          {
            "group": "Audio",
            "pages": [
              "POST /projects/{project}/studio-sound",
              "POST /projects/{project}/level"
            ]
          },
          {
            "group": "Look and check",
            "pages": [
              "POST /projects/{project}/frames",
              "POST /projects/{project}/checks"
            ]
          },
          {
            "group": "Live updates",
            "pages": [
              "GET /projects/{project}/events",
              "POST /projects/{project}/presence",
              "POST /projects/{project}/working_on"
            ]
          },
          {
            "group": "Comments",
            "pages": [
              "GET /projects/{project}/comments",
              "POST /projects/{project}/comments",
              "POST /projects/{project}/comments/{comment_id}",
              "DELETE /projects/{project}/comments/{comment_id}"
            ]
          },
          {
            "group": "Renders",
            "pages": [
              "POST /projects/{project}/renders",
              "GET /jobs/{job_id}",
              "POST /jobs/{job_id}/cancel"
            ]
          },
          {
            "group": "Status",
            "pages": [
              "GET /health"
            ]
          }
        ]
      },
      {
        "tab": "Editor, CLI and SDK",
        "groups": [
          {
            "group": "Mac editor",
            "pages": [
              "editor/index"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/index"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "sdk/index"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/tfcbot/vidjutsu-sdk",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://docs.vidjutsu.ai/quickstart"
    }
  },
